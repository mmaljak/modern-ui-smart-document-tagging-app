# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
API_TITLE="Smart Document Tagger"
API_VERSION="0.1.0"

# Comma-separated browser origins allowed to call the API (CORS).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Classification — local BART zero-shot backend ─────────────────────────────
HF_MODEL_NAME=facebook/bart-large-mnli
TAG_CONFIDENCE_THRESHOLD=0.97
ALWAYS_RETURN_MIN_TAGS=1
MAX_KEY_SENTENCES=3
MAX_SENTENCES_TO_SCORE=20

# ── Classification — local embedding backend (BGE-small, the default) ─────────
# BGE cosine similarities have their own distribution; this temperature is tuned
# independently of the OpenAI one. Lower ⇒ sharper confidence separation.
LOCAL_EMBEDDING_SOFTMAX_TEMPERATURE=0.04
LOCAL_EMBEDDING_TAG_THRESHOLD=0.05
LOCAL_EMBEDDING_MAX_CLASSIFY_CHARS=2000

# ── File validation ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=10485760   # 10 MB

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TAG_ENDPOINT=5/minute
